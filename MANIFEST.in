# MANIFEST.in - Files to include in source distribution

# Include key documentation
include LICENSE
include README.md
include CHANGELOG.md
include QUICKSTART.md
include CONTRIBUTING.md
include py.typed

# Include configuration files
include pyproject.toml
include Makefile
include requirements.txt

# Include source code
recursive-include src *.py
recursive-include src *.pyi
recursive-include src py.typed

# Include tests
recursive-include tests *.py
recursive-include tests *.json
recursive-include tests *.avsc
recursive-include tests *.yaml
recursive-include tests *.csv

# Include documentation
recursive-include docs *.md
recursive-include docs *.rst
recursive-include docs *.png
recursive-include docs *.svg

# Include benchmarks
recursive-include benchmarks *.py
recursive-include benchmarks *.json

# Include examples
recursive-include examples *.py
recursive-include examples *.yaml
recursive-include examples *.json

# Include Docker files
include docker/Dockerfile
include docker/docker-compose.yml

# Include GitHub workflows (for reference)
recursive-include .github *.yml

# Exclude compiled files
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude *.so
global-exclude *.dylib
global-exclude .DS_Store
global-exclude *.egg-info
global-exclude .git
global-exclude .gitignore
global-exclude .coverage
global-exclude .pytest_cache
global-exclude .mypy_cache
global-exclude .ruff_cache
global-exclude htmlcov
global-exclude dist
global-exclude build
# NOTE: *.onnx is NOT globally excluded. The bundled int8 encoder at
# src/nexus_matcher/_models/ is what makes this library work with no download and no
# HuggingFace access; a blanket exclusion silently produces a wheel that falls back to
# downloading, which is the exact failure mode we are trying to remove.
# Stray ONNX artefacts elsewhere are excluded individually instead.
exclude models/_bge_onnx_fp32/*.onnx
recursive-include src/nexus_matcher/_models *
